# Notion integration (씨앗 import 전용)
# https://www.notion.so/my-integrations 에서 internal integration 생성 후 토큰 복사
# 대상 데이터베이스를 integration에 "연결(Connections)" 해줘야 읽힘
NOTION_API_KEY=secret_xxx
# 신형 Notion API: data source ID (권장). 'Sources' 보드의 data source.
#   databases.retrieve(database_id) 응답의 data_sources[].id 또는
#   data source URL에서 추출. 둘 중 하나만 채우면 됨(아래 DATABASE_ID는 구형 폴백).
NOTION_DATA_SOURCE_ID=
# (구형 폴백) database ID. URL에서 추출:
#   https://www.notion.so/<workspace>/<DATABASE_ID>?v=...
NOTION_DATABASE_ID=

# arxiv/code 분석에 GitHub API 사용 시 (rate limit 완화용, 선택)
GITHUB_TOKEN=

# 임베딩 기반 Graph-RAG를 켤 때 사용 (선택, 초기엔 불필요)
ANTHROPIC_API_KEY=
